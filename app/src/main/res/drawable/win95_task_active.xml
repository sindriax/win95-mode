<?xml version="1.0" encoding="utf-8"?>
<!-- The active window's taskbar button in Win95: pushed in, with a light
     checkered fill, so it stands out from the raised buttons beside it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="@color/white" /></shape></item>
    <item android:right="2dp" android:bottom="2dp"><shape><solid android:color="@color/black" /></shape></item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp"><shape><solid android:color="@color/win95_dark_gray" /></shape></item>
    <item android:left="4dp" android:top="4dp" android:right="2dp" android:bottom="2dp" android:drawable="@drawable/win95_checker_tile" />
</layer-list>
