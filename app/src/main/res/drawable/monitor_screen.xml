<?xml version="1.0" encoding="utf-8"?>
<!-- Sunken glass: dark rim on the top and left, light on the bottom and right. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="@color/monitor_beige_light" /></shape></item>
    <item android:right="2dp" android:bottom="2dp"><shape><solid android:color="@color/monitor_beige_dark" /></shape></item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp"><shape><solid android:color="@color/black" /></shape></item>
</layer-list>
