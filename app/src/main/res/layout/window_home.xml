<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Launcher status: the one job of this screen. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/win95_inset"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/home_launcher_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/home_launcher_name"
                        style="@style/Win95Heading" />

                    <TextView
                        android:id="@+id/home_launcher_state"
                        style="@style/Win95Body" />

                    <TextView
                        android:id="@+id/home_launcher_when"
                        style="@style/Win95Caption"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/home_launcher_detail"
                style="@style/Win95Body"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_home_apply"
                style="@style/Win95Button.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/link_home_set_default"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:text="@string/set_as_home_screen"
                android:textColor="@color/win95_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            style="@style/Win95Heading"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/coverage_title" />

        <com.win95mode.app.BlockProgressBar
            android:id="@+id/home_coverage_bar"
            android:layout_width="match_parent"
            android:layout_height="22dp" />

        <TextView
            android:id="@+id/home_coverage_text"
            style="@style/Win95Body"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:id="@+id/home_preview_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:contentDescription="@string/preview_strip_desc" />

        <TextView
            android:id="@+id/btn_home_request"
            style="@style/Win95Button"
            android:layout_marginTop="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/win95_clock_inset" />

        <LinearLayout
            android:id="@+id/home_whats_new"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground">

            <TextView
                style="@style/Win95Body"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/whats_new_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chevron"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:importantForAccessibility="no" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
