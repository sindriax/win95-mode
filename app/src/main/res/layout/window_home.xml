<?xml version="1.0" encoding="utf-8"?>
<!-- No ScrollView: the monitor takes exactly the space left over, and fills it
     with as many icon rows as fit. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Launcher status: the one job of this screen. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/win95_inset"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/home_launcher_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/home_launcher_name"
                        style="@style/Win95Heading" />

                    <TextView
                        android:id="@+id/home_launcher_state"
                        style="@style/Win95Body" />

                    <TextView
                        android:id="@+id/home_launcher_when"
                        style="@style/Win95Caption"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/home_launcher_detail"
                style="@style/Win95Body"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_home_apply"
                style="@style/Win95Button.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/link_home_set_default"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:text="@string/set_as_home_screen"
                android:textColor="@color/win95_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- A 1995 monitor previewing this phone's home screen: the current
             wallpaper with this phone's apps in their Win95 icons. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:background="@drawable/monitor_bezel"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:id="@+id/home_monitor_screen"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/monitor_screen"
                    android:padding="2dp"
                    android:contentDescription="@string/home_desktop_desc">

                    <ImageView
                        android:id="@+id/home_monitor_wallpaper"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@color/win95_teal"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:id="@+id/home_monitor_icons"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingTop="6dp" />

                </FrameLayout>

                <!-- Chin with the power light. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="20dp">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="4dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="8dp"
                        android:background="#22CC22" />

                </FrameLayout>

            </LinearLayout>

            <View
                android:layout_width="56dp"
                android:layout_height="12dp"
                android:background="@drawable/monitor_stand" />

            <View
                android:layout_width="150dp"
                android:layout_height="10dp"
                android:background="@drawable/monitor_stand" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="10dp">

                <com.win95mode.app.BlockProgressBar
                    android:id="@+id/home_coverage_bar"
                    android:layout_width="match_parent"
                    android:layout_height="18dp" />

                <TextView
                    android:id="@+id/home_coverage_text"
                    style="@style/Win95Body"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/btn_home_request"
                style="@style/Win95Button" />

        </LinearLayout>

</LinearLayout>
