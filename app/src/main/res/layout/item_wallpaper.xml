<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="?android:attr/selectableItemBackground">

    <FrameLayout
        android:id="@+id/wall_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/win95_clock_inset"
        android:padding="3dp">

        <ImageView
            android:id="@+id/wall_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/wall_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@color/win95_navy"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/live_badge"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="12sp"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/wall_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:importantForAccessibility="no" />

</LinearLayout>
