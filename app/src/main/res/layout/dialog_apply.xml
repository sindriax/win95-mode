<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/win95_window_border"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@drawable/win95_titlebar"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="3dp">

        <TextView
            android:id="@+id/apply_title"
            android:text="@string/choose_launcher_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/btn_close_apply"
            android:layout_width="32dp"
            android:layout_height="26dp"
            android:background="@drawable/win95_button_selector"
            android:contentDescription="@string/close"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="@string/close_button"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@color/win95_gray">

        <TextView
            android:id="@+id/apply_text"
            style="@style/Win95Body"
            android:text="@string/choose_launcher"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/launcher_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/btn_cancel_apply"
            style="@style/Win95Button"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:text="@string/cancel" />

    </LinearLayout>

</LinearLayout>
