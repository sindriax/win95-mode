<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/win95_window_border"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@drawable/win95_titlebar"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="3dp">

        <TextView
            android:id="@+id/wallpaper_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/btn_close_wallpaper"
            android:layout_width="32dp"
            android:layout_height="26dp"
            android:background="@drawable/win95_button_selector"
            android:contentDescription="@string/close"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="@string/close_button"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:gravity="center_horizontal"
        android:background="@color/win95_gray">

        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="240dp"
            android:background="@drawable/win95_clock_inset"
            android:padding="3dp"
            android:layout_marginBottom="14dp">

            <ImageView
                android:id="@+id/dlg_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/wallpaper_preview_desc" />

        </FrameLayout>

        <TextView
            style="@style/Win95Body"
            android:gravity="center"
            android:text="@string/apply_to"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_home"
                style="@style/Win95Button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/home_screen" />

            <TextView
                android:id="@+id/btn_lock"
                style="@style/Win95Button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_marginStart="6dp"
                android:text="@string/lock_screen" />

            <TextView
                android:id="@+id/btn_both"
                style="@style/Win95Button.Primary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="44dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_marginStart="6dp"
                android:text="@string/both_screens" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
