<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/win95_teal"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/desktop_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- One window; its title, icon and content follow the taskbar selection. It is
             maximized for Icons and Wallpapers and sized to its content on Home, where
             the desktop shows below it. -->
        <LinearLayout
            android:id="@+id/window_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:orientation="vertical"
            android:background="@drawable/win95_window_border"
            android:padding="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:background="@drawable/win95_titlebar"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="3dp">

                <ImageView
                    android:id="@+id/window_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/window_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:accessibilityHeading="true" />

                <FrameLayout
                    android:id="@+id/btn_minimize"
                    android:layout_width="36dp"
                    android:layout_height="28dp"
                    android:background="@drawable/win95_button_selector"
                    android:contentDescription="@string/minimize"
                    android:layout_marginEnd="2dp">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="2dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="7dp"
                        android:background="@color/black" />

                </FrameLayout>

                <!-- Drawn disabled, as Win95 does for a maximized window. -->
                <TextView
                    android:id="@+id/btn_maximize"
                    android:layout_width="36dp"
                    android:layout_height="28dp"
                    android:background="@drawable/win95_button"
                    android:enabled="false"
                    android:importantForAccessibility="no"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="@string/maximize_button"
                    android:textColor="@color/win95_dark_gray"
                    android:shadowColor="@color/white"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="0.01"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/btn_close"
                    android:layout_width="36dp"
                    android:layout_height="28dp"
                    android:background="@drawable/win95_button_selector"
                    android:contentDescription="@string/close"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="@string/close_button"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/window_pages"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/win95_gray">

                <include android:id="@+id/page_home" layout="@layout/window_home" />
                <include android:id="@+id/page_icons" layout="@layout/window_icons" android:visibility="gone" />
                <include android:id="@+id/page_wallpapers" layout="@layout/window_wallpapers" android:visibility="gone" />

            </FrameLayout>

            <TextView
                android:id="@+id/window_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="26dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/win95_clock_inset"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:accessibilityLiveRegion="polite" />

        </LinearLayout>

        <!-- Desktop shortcuts, shown on Home. -->
        <FrameLayout
            android:id="@+id/desktop"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">

            <GridLayout
                android:id="@+id/desktop_icons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="12dp"
                android:columnCount="3" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/taskbar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/win95_taskbar"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="2dp">

            <LinearLayout
                android:id="@+id/btn_start"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/win95_button_selector"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="10dp"
                android:contentDescription="@string/start_button">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_start"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/start_button"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginStart="5dp"
                    android:importantForAccessibility="no" />

            </LinearLayout>

            <TextView
                android:id="@+id/task_home"
                style="@style/Win95Task"
                android:text="@string/tab_home" />

            <TextView
                android:id="@+id/task_icons"
                style="@style/Win95Task"
                android:text="@string/tab_icons" />

            <TextView
                android:id="@+id/task_wallpapers"
                style="@style/Win95Task"
                android:text="@string/tab_wallpapers" />

            <LinearLayout
                android:id="@+id/taskbar_clock"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/win95_clock_inset"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm a"
                    android:format24Hour="HH:mm"
                    android:textColor="@color/black"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/start_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/start_menu"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="50dp"
        android:background="@drawable/win95_window_border"
        android:orientation="horizontal"
        android:padding="3dp"
        android:visibility="gone">

        <com.win95mode.app.StartBanner
            android:layout_width="30dp"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/start_items"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

    </LinearLayout>

</FrameLayout>
