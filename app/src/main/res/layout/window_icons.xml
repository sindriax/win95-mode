<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <EditText
        android:id="@+id/icon_search"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/win95_inset"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:hint="@string/icon_search_hint"
        android:textColorHint="@color/win95_text_secondary"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:maxLines="1"
        android:importantForAutofill="no" />

    <LinearLayout
        android:id="@+id/icon_tabs"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/win95_page"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/icons_summary_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/icons_summary"
                style="@style/Win95Body"
                android:layout_width="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_icons_request"
                style="@style/Win95Button"
                android:text="@string/request_ellipsis" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/icons_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

    </LinearLayout>

</LinearLayout>
